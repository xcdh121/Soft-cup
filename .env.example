VITE_SERVER_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
STORAGE_ROOT=./.localdata
TASK_QUEUE_BACKEND=local
TASK_QUEUE_NAME=edu-agent:tasks
REDIS_URL=redis://localhost:6379/0
TASK_JOB_TIMEOUT_SECONDS=900
TASK_JOB_MAX_TRIES=3
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_APP_ID=
EMBEDDING_API_SECRET=
EMBEDDING_DOMAIN=query
EMBEDDING_DIMENSIONS=3072
XFYUN_PPT_ENABLED=false
XFYUN_PPT_BASE_URL=https://zwapi.xfyun.cn
XFYUN_PPT_APP_ID=
XFYUN_PPT_SECRET=
XFYUN_PPT_BUSINESS_ID=
XFYUN_PPT_DEFAULT_AUTHOR=EduAgent
XFYUN_PPT_DEFAULT_LANGUAGE=cn
XFYUN_PPT_DEFAULT_SEARCH=false
XFYUN_PPT_DEFAULT_IS_CARD_NOTE=false
XFYUN_PPT_DEFAULT_IS_FIGURE=false
XFYUN_PPT_DEFAULT_AI_IMAGE=normal

# Baidu AI Search (server-side only)
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com
BAIDU_SEARCH_VIDEO_TOP_K=6
BAIDU_SEARCH_SITES=bilibili.com
BAIDU_SEARCH_TIMEOUT_SECONDS=15
XFYUN_PPT_POLL_INTERVAL_SECONDS=3
XFYUN_PPT_POLL_TIMEOUT_SECONDS=180

# XFYun Chinese speech recognition (server-side only)
XFYUN_IAT_ENABLED=false
XFYUN_IAT_APP_ID=
XFYUN_IAT_API_KEY=
XFYUN_IAT_API_SECRET=
XFYUN_IAT_HOST=iat.xf-yun.com
XFYUN_IAT_PATH=/v1
ALLOW_DEV_AUTH_BYPASS=true

MAX_DOCUMENT_UPLOADS_PER_DAY=5
MAX_QUIZ_GENERATIONS_PER_DAY=10
MAX_FLASHCARD_GENERATIONS_PER_DAY=10
MAX_CHAT_MESSAGES_PER_DAY=50

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
