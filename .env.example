VITE_SERVER_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/postgres
BILLING_ENVIRONMENT=development
BILLING_MANUAL_PAYMENT_ENABLED=true
BILLING_ORDER_EXPIRY_MINUTES=30
# 比赛演示人工收款：二维码图片建议放在 edu-web/public/payment-codes/，这里只配置浏览器可访问的 URL。
# 生产环境请关闭人工收款并接入有验签回调的正式商户渠道。
BILLING_MANUAL_PAYMENT_RECIPIENT=
BILLING_MANUAL_WECHAT_QR_URL=/payment-codes/wechat.jpg
BILLING_MANUAL_QQ_QR_URL=/payment-codes/qq.png
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000/api/v1/billing/payment-notify
STORAGE_ROOT=./.localdata
TASK_QUEUE_BACKEND=local
TASK_QUEUE_NAME=edu-agent:tasks
REDIS_URL=redis://localhost:6379/0
TASK_JOB_TIMEOUT_SECONDS=900
TASK_JOB_MAX_TRIES=3
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Optional provider price in CNY per one million tokens. Token usage is still
# recorded when these are zero, but estimated cost is shown as unconfigured.
LLM_INPUT_COST_PER_MILLION_CNY=0
LLM_OUTPUT_COST_PER_MILLION_CNY=0
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_APP_ID=
EMBEDDING_API_SECRET=
EMBEDDING_DOMAIN=query
EMBEDDING_DIMENSIONS=3072
XFYUN_PPT_ENABLED=false
XFYUN_PPT_BASE_URL=https://zwapi.xfyun.cn
XFYUN_PPT_APP_ID=
XFYUN_PPT_SECRET=
XFYUN_PPT_BUSINESS_ID=
XFYUN_PPT_DEFAULT_AUTHOR=EduAgent
XFYUN_PPT_DEFAULT_LANGUAGE=cn
XFYUN_PPT_DEFAULT_SEARCH=false
XFYUN_PPT_DEFAULT_IS_CARD_NOTE=false
XFYUN_PPT_DEFAULT_IS_FIGURE=false
XFYUN_PPT_DEFAULT_AI_IMAGE=normal

# XFYun Spark text-to-image generation (server-side only)
XFYUN_IMAGE_GENERATION_ENABLED=false
XFYUN_IMAGE_GENERATION_APP_ID=
XFYUN_IMAGE_GENERATION_API_KEY=
XFYUN_IMAGE_GENERATION_API_SECRET=
XFYUN_IMAGE_GENERATION_BASE_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti
XFYUN_IMAGE_GENERATION_TIMEOUT_SECONDS=120
XFYUN_IMAGE_GENERATION_DEFAULT_WIDTH=512
XFYUN_IMAGE_GENERATION_DEFAULT_HEIGHT=512

# Baidu AI Search (server-side only)
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com
BAIDU_SEARCH_VIDEO_TOP_K=6
BAIDU_SEARCH_SITES=bilibili.com
BAIDU_SEARCH_TIMEOUT_SECONDS=15
XFYUN_PPT_POLL_INTERVAL_SECONDS=3
XFYUN_PPT_POLL_TIMEOUT_SECONDS=180

# XFYun Chinese speech recognition (server-side only)
XFYUN_IAT_ENABLED=false
XFYUN_IAT_APP_ID=
XFYUN_IAT_API_KEY=
XFYUN_IAT_API_SECRET=
XFYUN_IAT_HOST=iat.xf-yun.com
XFYUN_IAT_PATH=/v1

# XFYun handwriting recognition (server-side only)
XFYUN_HANDWRITING_ENABLED=false
XFYUN_HANDWRITING_APP_ID=
XFYUN_HANDWRITING_API_KEY=
XFYUN_HANDWRITING_BASE_URL=https://webapi.xfyun.cn/v1/service/v1/ocr/handwriting
XFYUN_HANDWRITING_TIMEOUT_SECONDS=30

# XFYun Spark image understanding (AI tutor image attachments)
XFYUN_IMAGE_UNDERSTANDING_ENABLED=false
XFYUN_IMAGE_UNDERSTANDING_APP_ID=
XFYUN_IMAGE_UNDERSTANDING_API_KEY=
XFYUN_IMAGE_UNDERSTANDING_API_SECRET=
XFYUN_IMAGE_UNDERSTANDING_BASE_URL=wss://spark-api.cn-huabei-1.xf-yun.com/v2.1/image
XFYUN_IMAGE_UNDERSTANDING_DOMAIN=imagev3
XFYUN_IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=60
XFYUN_IMAGE_UNDERSTANDING_MAX_TOKENS=2048

# XFYun PDF document OCR (server-side only)
XFYUN_PDF_OCR_ENABLED=false
XFYUN_PDF_OCR_APP_ID=
XFYUN_PDF_OCR_SECRET=
XFYUN_PDF_OCR_BASE_URL=https://iocr.xfyun.cn/ocrzdq/v1/pdfOcr
XFYUN_PDF_OCR_TIMEOUT_SECONDS=120

# XFYun Machine Translation (New)
XFYUN_TRANSLATION_ENABLED=false
XFYUN_TRANSLATION_APP_ID=
XFYUN_TRANSLATION_API_KEY=
XFYUN_TRANSLATION_API_SECRET=
XFYUN_TRANSLATION_BASE_URL=https://itrans.xf-yun.com/v1/its
XFYUN_TRANSLATION_TIMEOUT_SECONDS=30

# Sandboxed programming runner (self-hosted Piston-compatible execute endpoint)
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_TOKEN=
CODE_EXECUTION_TIMEOUT_SECONDS=15
ALLOW_DEV_AUTH_BYPASS=false
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_ALLOW_REGISTRATION=true
AUTH_ADMIN_USERNAMES=

MAX_DOCUMENT_UPLOADS_PER_DAY=5
MAX_QUIZ_GENERATIONS_PER_DAY=10
MAX_FLASHCARD_GENERATIONS_PER_DAY=10
MAX_CHAT_MESSAGES_PER_DAY=50

# XFYun digital avatar Web SDK (bundled into the browser application)
VITE_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
VITE_AVATAR_APP_ID=
VITE_AVATAR_API_KEY=
VITE_AVATAR_API_SECRET=
VITE_AVATAR_SCENE_ID=
VITE_AVATAR_ID=
VITE_AVATAR_VCN=
