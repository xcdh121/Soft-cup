# Copy to .env.production with scripts/init-production-env.sh.
# POSTGRES_PASSWORD must stay URL-safe because it is embedded in DATABASE_URL.
POSTGRES_USER=eduagent
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
POSTGRES_DB=eduagent
AUTH_JWT_SECRET=CHANGE_ME_GENERATED
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_ALLOW_REGISTRATION=true
AUTH_ADMIN_USERNAMES=admin
ALLOW_DEV_AUTH_BYPASS=false

# Competition-only manual QR payment. Disable this and configure a verified
# merchant provider before commercial use.
BILLING_ENVIRONMENT=competition
BILLING_MANUAL_PAYMENT_ENABLED=true
BILLING_ORDER_EXPIRY_MINUTES=30
BILLING_MANUAL_PAYMENT_RECIPIENT=
BILLING_MANUAL_WECHAT_QR_URL=/payment-codes/wechat.jpg
BILLING_MANUAL_QQ_QR_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=https://wanjing.xyz/api/v1/billing/payment-notify

# External AI provider. Do not run a local LLM on a 2-4 GB server.
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_INPUT_COST_PER_MILLION_CNY=0
LLM_OUTPUT_COST_PER_MILLION_CNY=0
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_APP_ID=
EMBEDDING_API_SECRET=
EMBEDDING_DOMAIN=query
EMBEDDING_DIMENSIONS=3072

# Queue and low-memory production defaults.
TASK_JOB_TIMEOUT_SECONDS=900
TASK_JOB_MAX_TRIES=3
WORKER_MAX_JOBS=1
PISTON_MAX_CONCURRENT_JOBS=1

# Public HTTP endpoint. Keep VITE_SERVER_URL unset: the SPA uses its current
# public IP/domain and Nginx proxies /api to the private API container.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
VITE_SERVER_URL=

# Daily per-user limits.
MAX_DOCUMENT_UPLOADS_PER_DAY=5
MAX_QUIZ_GENERATIONS_PER_DAY=10
MAX_FLASHCARD_GENERATIONS_PER_DAY=10
MAX_CHAT_MESSAGES_PER_DAY=50

# Optional XFYun/Baidu integrations. Enable and fill credentials as needed.
XFYUN_PPT_ENABLED=false
XFYUN_PPT_APP_ID=
XFYUN_PPT_SECRET=
XFYUN_PPT_BUSINESS_ID=
XFYUN_IMAGE_GENERATION_ENABLED=false
XFYUN_IMAGE_GENERATION_APP_ID=
XFYUN_IMAGE_GENERATION_API_KEY=
XFYUN_IMAGE_GENERATION_API_SECRET=
BAIDU_SEARCH_API_KEY=
XFYUN_IAT_ENABLED=false
XFYUN_IAT_APP_ID=
XFYUN_IAT_API_KEY=
XFYUN_IAT_API_SECRET=
XFYUN_HANDWRITING_ENABLED=false
XFYUN_HANDWRITING_APP_ID=
XFYUN_HANDWRITING_API_KEY=
XFYUN_IMAGE_UNDERSTANDING_ENABLED=false
XFYUN_IMAGE_UNDERSTANDING_APP_ID=
XFYUN_IMAGE_UNDERSTANDING_API_KEY=
XFYUN_IMAGE_UNDERSTANDING_API_SECRET=
XFYUN_PDF_OCR_ENABLED=false
XFYUN_PDF_OCR_APP_ID=
XFYUN_PDF_OCR_SECRET=
XFYUN_TRANSLATION_ENABLED=false
XFYUN_TRANSLATION_APP_ID=
XFYUN_TRANSLATION_API_KEY=
XFYUN_TRANSLATION_API_SECRET=

# Browser-bundled avatar credentials. Anything prefixed VITE_ is public and
# must never contain a privileged server-side secret.
VITE_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
VITE_AVATAR_APP_ID=
VITE_AVATAR_API_KEY=
VITE_AVATAR_API_SECRET=
VITE_AVATAR_SCENE_ID=
VITE_AVATAR_ID=
VITE_AVATAR_VCN=

# Resource caps tuned for a 2-core/4-GB host. They are hard limits, not fixed
# reservations, so idle containers use much less memory.
WEB_MEMORY_LIMIT=128m
API_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=1024m
MIGRATE_MEMORY_LIMIT=512m
PISTON_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=160m
DB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=0.25
API_CPU_LIMIT=0.75
WORKER_CPU_LIMIT=0.75
PISTON_CPU_LIMIT=0.75
REDIS_CPU_LIMIT=0.25
DB_CPU_LIMIT=0.50
